{
  "compilerOptions": {
    "rootDir": "./src",
    "lib": ["es2023"],
    "target": "es2023",
    "module": "esnext",
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "types": ["node", "jest"],
    "noEmit": true,
    "strict": true,
    "strictNullChecks": true
  }
}
